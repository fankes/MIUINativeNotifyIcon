<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorThemeBackground"
    android:orientation="vertical"
    tools:context=".ui.activity.MainActivity"
    tools:ignore="UseCompoundDrawables,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:gravity="center|start"
        android:padding="15dp">

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/title_back_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/common_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="@string/config_title"
            android:textColor="@color/colorTextGray"
            android:textSize="19sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_options"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="13dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_options" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_sync"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginEnd="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sync"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_sync_list" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/bg_permotion_round"
        android:elevation="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="15dp">

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.85"
            android:src="@drawable/ic_about"
            android:tint="@color/colorTextDark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:lineSpacingExtra="5dp"
            android:text="@string/config_description"
            android:textColor="@color/colorTextGray"
            android:textSize="11sp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <com.fankes.miui.notify.ui.widget.MaterialSwitch
        android:id="@+id/notify_icon_fix_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/bg_permotion_round"
        android:foreground="@drawable/fg_permotion_ripple"
        android:paddingLeft="15dp"
        android:paddingTop="10dp"
        android:paddingRight="15dp"
        android:paddingBottom="10dp"
        android:text="@string/main_enable_icon_optimize"
        android:textAllCaps="false"
        android:textColor="@color/colorTextGray"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/config_disabled_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/notify_icon_optimization_disabled"
            android:textColor="@color/colorTextDark"
            android:textSize="17sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/config_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="11dp"
                    android:paddingRight="11dp">

                    <TextView
                        android:id="@+id/config_view_installed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_view_pill"
                        android:paddingLeft="14dp"
                        android:paddingTop="7dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="7dp"
                        android:singleLine="true"
                        android:text="@string/config_view_installed"
                        android:textColor="@color/selector_view_pill_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/config_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_view_pill"
                        android:paddingLeft="14dp"
                        android:paddingTop="7dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="7dp"
                        android:singleLine="true"
                        android:text="@string/config_view_all"
                        android:textColor="@color/selector_view_pill_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/config_view_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_view_pill"
                        android:paddingLeft="14dp"
                        android:paddingTop="7dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="7dp"
                        android:singleLine="true"
                        android:text="@string/config_view_enabled"
                        android:textColor="@color/selector_view_pill_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/config_view_overridden"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:background="@drawable/bg_view_pill"
                        android:paddingLeft="14dp"
                        android:paddingTop="7dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="7dp"
                        android:singleLine="true"
                        android:text="@string/config_view_overridden"
                        android:textColor="@color/selector_view_pill_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="25dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/config_title_count_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:text="@string/config_list_loading"
                    android:textColor="@color/colorTextDark"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/config_uncovered_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_pill_round"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:singleLine="true"
                    android:textColor="@color/colorTextGray"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Not included: 12" />

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/config_title_filter"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_filter"
                    android:tint="@color/colorTextGray"
                    android:tooltipText="@string/config_filter" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/config_list_no_data_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/config_no_data"
                    android:textColor="@color/colorTextDark"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/config_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadingEdgeLength="10dp"
                    android:padding="15dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/config_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="15dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/config_cbr_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_round"
                    android:gravity="center"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:text="@string/config_contribute_anip"
                    android:textColor="@color/colorTextGray"
                    android:textSize="15sp" />

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/config_title_up"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_round"
                    android:padding="11dp"
                    android:src="@drawable/ic_page_top"
                    android:tint="@color/colorTextGray"
                    android:tooltipText="@string/config_scroll_top" />

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/config_title_down"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_round"
                    android:padding="11dp"
                    android:src="@drawable/ic_page_bottom"
                    android:tint="@color/colorTextGray"
                    android:tooltipText="@string/config_scroll_bottom" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>