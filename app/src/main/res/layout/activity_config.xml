<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorThemeBackground"
    android:orientation="vertical"
    tools:context=".ui.activity.MainActivity"
    tools:ignore="UseCompoundDrawables,ContentDescription,UselessParent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:elevation="0dp"
        android:gravity="center|start"
        android:paddingStart="15dp"
        android:paddingTop="15dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp">

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/title_back_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="15dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/abc_action_bar_up_description" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="@string/config_title"
            android:textColor="@color/colorTextGray"
            android:textSize="18sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="18sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_options"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="15dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_options" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_restore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="15dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_restore_rules"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_restore_rules"
            android:visibility="gone" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_sync"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="15dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sync"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_sync_list" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 允许数量栏的无边界水波纹越过 AppBar 底部，父布局链均不裁剪子视图 -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/config_app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorThemeBackground"
                android:clipChildren="false"
                app:elevation="0dp"
                app:liftOnScroll="false"
                app:liftOnScrollColor="@color/colorThemeBackground">

                <LinearLayout
                    android:id="@+id/config_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_permotion_round"
                    android:elevation="0dp"
                    android:gravity="center|start"
                    android:orientation="horizontal"
                    android:padding="15dp"
                    app:layout_scrollFlags="scroll">

                    <androidx.constraintlayout.utils.widget.ImageFilterView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="10dp"
                        android:alpha="0.85"
                        android:src="@drawable/ic_about"
                        android:tint="@color/colorTextDark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/config_description"
                        android:textColor="@color/colorTextGray"
                        android:textSize="11sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <com.fankes.miui.notify.ui.widget.AppSwitch
                        android:id="@+id/notify_icon_fix_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:background="@drawable/bg_permotion_round"
                        android:foreground="@drawable/fg_permotion_ripple"
                        android:paddingLeft="15dp"
                        android:paddingTop="10dp"
                        android:paddingRight="15dp"
                        android:paddingBottom="10dp"
                        android:text="@string/main_enable_icon_optimize"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextGray"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/config_list_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <HorizontalScrollView
                            android:id="@+id/config_view_pills"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingLeft="11dp"
                                android:paddingRight="11dp">

                                <TextView
                                    android:id="@+id/config_view_all"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/bg_view_pill"
                                    android:paddingLeft="14dp"
                                    android:paddingTop="7dp"
                                    android:paddingRight="14dp"
                                    android:paddingBottom="7dp"
                                    android:singleLine="true"
                                    android:text="@string/config_view_all"
                                    android:textColor="@color/selector_view_pill_text"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/config_view_installed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/bg_view_pill"
                                    android:paddingLeft="14dp"
                                    android:paddingTop="7dp"
                                    android:paddingRight="14dp"
                                    android:paddingBottom="7dp"
                                    android:singleLine="true"
                                    android:text="@string/config_view_installed"
                                    android:textColor="@color/selector_view_pill_text"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/config_view_disabled"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/bg_view_pill"
                                    android:paddingLeft="14dp"
                                    android:paddingTop="7dp"
                                    android:paddingRight="14dp"
                                    android:paddingBottom="7dp"
                                    android:singleLine="true"
                                    android:text="@string/config_view_disabled"
                                    android:textColor="@color/selector_view_pill_text"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/config_view_overridden"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/bg_view_pill"
                                    android:paddingLeft="14dp"
                                    android:paddingTop="7dp"
                                    android:paddingRight="14dp"
                                    android:paddingBottom="7dp"
                                    android:singleLine="true"
                                    android:text="@string/config_view_overridden"
                                    android:textColor="@color/selector_view_pill_text"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <LinearLayout
                            android:id="@+id/config_count_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="25dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginRight="25dp"
                            android:animateLayoutChanges="true"
                            android:baselineAligned="false"
                            android:clipChildren="false"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/config_title_count_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center_vertical|start"
                                android:maxLines="1"
                                android:text="@string/config_list_loading"
                                android:textColor="@color/colorTextDark"
                                android:textSize="13sp"
                                app:autoSizeMaxTextSize="13sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform" />

                            <!-- 水波纹放在前景，避免向 AppBar 背景投影后在底部被裁剪 -->
                            <androidx.constraintlayout.utils.widget.ImageFilterView
                                android:id="@+id/config_select_all"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@string/config_select_mode"
                                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_select_all"
                                android:tint="@color/colorTextGray"
                                android:tooltipText="@string/config_select_mode" />

                            <androidx.constraintlayout.utils.widget.ImageFilterView
                                android:id="@+id/config_invert_selection"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@string/config_invert_selection"
                                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_invert_selection"
                                android:tint="@color/colorTextGray"
                                android:tooltipText="@string/config_invert_selection"
                                android:visibility="gone" />

                            <androidx.constraintlayout.utils.widget.ImageFilterView
                                android:id="@+id/config_title_filter"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_filter"
                                android:tint="@color/colorTextGray"
                                android:tooltipText="@string/config_filter" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <TextView
                    android:id="@+id/config_disabled_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/notify_icon_optimization_disabled"
                    android:textColor="@color/colorTextDark"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/config_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/config_list_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            app:indicatorColor="@color/colorPrimaryAccent" />

                        <TextView
                            android:id="@+id/config_list_no_data_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="25dp"
                            android:layout_marginRight="25dp"
                            android:gravity="center"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/config_no_data"
                            android:textColor="@color/colorTextDark"
                            android:textSize="17sp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/config_list_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fadingEdgeLength="10dp"
                            android:paddingLeft="15dp"
                            android:paddingTop="12dp"
                            android:paddingRight="15dp"
                            android:requiresFadingEdge="vertical"
                            android:scrollbars="none" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/config_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/config_bulk_enable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:alpha="0.5"
            android:background="@drawable/bg_button_round"
            android:enabled="false"
            android:gravity="center"
            android:maxLines="1"
            android:padding="10dp"
            android:text="@string/config_item_enable"
            android:textColor="@color/colorTextGray"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/config_bulk_disable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:alpha="0.5"
            android:background="@drawable/bg_button_round"
            android:enabled="false"
            android:gravity="center"
            android:maxLines="1"
            android:padding="10dp"
            android:text="@string/config_bulk_disable"
            android:textColor="@color/colorTextGray"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/config_bulk_override"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:alpha="0.5"
            android:background="@drawable/bg_button_round"
            android:enabled="false"
            android:gravity="center"
            android:maxLines="1"
            android:padding="10dp"
            android:text="@string/config_item_override"
            android:textColor="@color/colorTextGray"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/config_bulk_no_override"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.5"
            android:background="@drawable/bg_button_round"
            android:enabled="false"
            android:gravity="center"
            android:maxLines="1"
            android:padding="10dp"
            android:text="@string/config_bulk_no_override"
            android:textColor="@color/colorTextGray"
            android:textSize="15sp"
            app:autoSizeMaxTextSize="15sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/config_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="center">

        <TextView
            android:id="@+id/config_cbr_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button_round"
            android:gravity="center"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/config_contribute_anip"
            android:textColor="@color/colorTextGray"
            android:textSize="15sp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_up"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_round"
            android:padding="11dp"
            android:src="@drawable/ic_page_top"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_scroll_top" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/config_title_down"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_round"
            android:padding="11dp"
            android:src="@drawable/ic_page_bottom"
            android:tint="@color/colorTextGray"
            android:tooltipText="@string/config_scroll_bottom" />
    </LinearLayout>
</LinearLayout>