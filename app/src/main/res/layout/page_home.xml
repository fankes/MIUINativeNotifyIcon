<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadingEdgeLength="10dp"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical"
    tools:ignore="HardcodedText,UseCompoundDrawables,ContentDescription,UnusedAttribute,TooManyViews">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/main_lin_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            app:cardBackgroundColor="@color/colorStatusInactiveContainer"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/main_img_status"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-27dp"
                android:layout_marginBottom="-31dp"
                android:src="@drawable/ic_status_error" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/main_text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/main_module_status_unknown"
                    android:textColor="@color/colorTextGray"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center|start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/main_text_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/main_module_version"
                        android:textColor="@color/colorTextGray"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/main_text_release_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_orange_round"
                        android:ellipsize="end"
                        android:paddingLeft="8dp"
                        android:paddingTop="2dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2dp"
                        android:singleLine="true"
                        android:text="@string/main_click_to_update"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/main_text_miui_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/colorTextGray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/main_text_api_way"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:alpha="0.6"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="..."
                    android:textColor="@color/colorTextGray"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/main_optimize_list_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/bg_permotion_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notify_icon"
                    app:tint="@color/colorTextGray" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/config_title"
                    android:textColor="@color/colorTextGray"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_optimize_list_summary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/config_list_loading"
                    android:textColor="@color/colorTextDark"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:alpha="0.5"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/colorTextGray" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="25dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/main_group_debug"
            android:textColor="@color/colorTextGray"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_permotion_round"
            android:elevation="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <com.fankes.miui.notify.ui.widget.MaterialSwitch
                android:id="@+id/module_enable_log_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:paddingTop="5dp"
                android:paddingBottom="8dp"
                android:text="@string/main_enable_debug_log"
                android:textColor="@color/colorTextGray"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/exp_all_debug_log_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginRight="13dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_round"
                android:ellipsize="end"
                android:gravity="center"
                android:padding="10dp"
                android:singleLine="true"
                android:text="@string/main_export_debug_log"
                android:textColor="@color/colorTextGray"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:lineSpacingExtra="6dp"
                android:text="@string/main_debug_log_desc"
                android:textColor="@color/colorTextDark"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="25dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/main_group_display"
            android:textColor="@color/colorTextGray"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="@drawable/bg_permotion_round"
            android:elevation="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:paddingRight="15dp">

            <com.fankes.miui.notify.ui.widget.MaterialSwitch
                android:id="@+id/hide_icon_in_launcher_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:paddingBottom="8dp"
                android:text="@string/main_hide_launcher_icon"
                android:textColor="@color/colorTextGray"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:lineSpacingExtra="6dp"
                android:text="@string/main_hide_launcher_icon_desc"
                android:textColor="@color/colorTextDark"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:alpha="0.6"
                android:lineSpacingExtra="6dp"
                android:text="@string/main_hide_launcher_icon_warn"
                android:textColor="#FF5722"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>