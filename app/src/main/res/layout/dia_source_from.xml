<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="15dp"
    android:paddingTop="15dp"
    android:paddingRight="15dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8.5dp"
        android:layout_marginRight="8.5dp"
        android:layout_marginBottom="10dp"
        android:lineSpacingExtra="6dp"
        android:text="@string/sync_source_desc"
        android:textColor="@color/colorTextDark"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/source_chip_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:chipSpacingVertical="8dp">

        <com.fankes.miui.notify.ui.widget.AppChip
            android:id="@+id/source_chip_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_source_cdn_1" />

        <com.fankes.miui.notify.ui.widget.AppChip
            android:id="@+id/source_chip_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_source_cdn_2" />

        <com.fankes.miui.notify.ui.widget.AppChip
            android:id="@+id/source_chip_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_source_github" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/source_repository_text_lin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/sync_repository_hint"
        app:endIconContentDescription="@string/sync_restore_default"
        app:endIconDrawable="@drawable/ic_restore"
        app:endIconMode="custom"
        app:helperText="@string/sync_repository_helper">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/source_repository_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>